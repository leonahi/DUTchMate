*.kicad_sch-bak
*.kicad_pcb-bak
*.kicad_pro-bak
*.kicad_sym-bak
*.kicad_mod-bak
*.kicad_wks-bak
~*.lck
_autosave-*
*.autosave
fp-info-cache
*-cache.lib
*-rescue.lib
*-rescue.dcm

# Conventional scratch export directories. Release-ready outputs belong in a
# reviewed manufacturing directory and remain trackable.
gerbers/
fab/

