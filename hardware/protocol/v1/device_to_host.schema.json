{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dutchmate.dev/protocol/v1/device_to_host.schema.json",
  "title": "DUTchMate v1 Device-to-Host Message",
  "$defs": {
    "timestamp_us": {
      "type": "integer",
      "minimum": 0
    },
    "capability": {
      "type": "string",
      "enum": [
        "uart_receive",
        "gpio_control",
        "uart_send",
        "device_timestamp",
        "overflow_telemetry",
        "gpio_events",
        "power_sense",
        "msgpack"
      ]
    }
  },
  "oneOf": [
    {
      "title": "Hello Message",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "v",
        "firmware",
        "device",
        "capabilities"
      ],
      "properties": {
        "type": {
          "const": "hello"
        },
        "v": {
          "const": 1
        },
        "firmware": {
          "type": "string",
          "minLength": 1,
          "$comment": "Runtime validation requires 1..64 UTF-8 bytes, no Unicode Cc characters, and no leading or trailing Unicode White_Space; accepted values are preserved exactly."
        },
        "device": {
          "type": "string",
          "minLength": 1,
          "$comment": "Runtime validation requires 1..64 UTF-8 bytes, no Unicode Cc characters, and no leading or trailing Unicode White_Space; accepted values are preserved exactly."
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          },
          "uniqueItems": true
        }
      }
    },
    {
      "title": "UART Event",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "channel",
        "timestamp_us",
        "data_b64"
      ],
      "properties": {
        "type": {
          "const": "uart"
        },
        "channel": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_us": {
          "$ref": "#/$defs/timestamp_us"
        },
        "data_b64": {
          "type": "string",
          "contentEncoding": "base64",
          "$comment": "Runtime validation requires base64 that decodes to 1..32768 bytes; accepted payloads are preserved exactly."
        }
      }
    },
    {
      "title": "Buffer Overflow Event",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "channel",
        "timestamp_us",
        "dropped_bytes"
      ],
      "properties": {
        "type": {
          "const": "buffer_overflow"
        },
        "channel": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_us": {
          "$ref": "#/$defs/timestamp_us"
        },
        "dropped_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    {
      "title": "Buffer Status Event",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "timestamp_us",
        "uart_rx_size_bytes",
        "uart_rx_used_bytes",
        "uart_rx_high_water_bytes",
        "dropped_bytes_total",
        "overflow_events"
      ],
      "properties": {
        "type": {
          "const": "buffer_status"
        },
        "timestamp_us": {
          "$ref": "#/$defs/timestamp_us"
        },
        "uart_rx_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "uart_rx_used_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "uart_rx_high_water_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_bytes_total": {
          "type": "integer",
          "minimum": 0
        },
        "overflow_events": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "title": "Command Success Response",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "timestamp_us": {
          "$ref": "#/$defs/timestamp_us"
        },
        "bytes_accepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        }
      }
    },
    {
      "$ref": "errors.schema.json"
    },
    {
      "title": "DUT VIO Observation",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "timestamp_us",
        "status",
        "adc_raw",
        "voltage_mv",
        "adc_reference_mv",
        "reference_source"
      ],
      "properties": {
        "type": {
          "const": "dut_vio"
        },
        "timestamp_us": {
          "$ref": "#/$defs/timestamp_us"
        },
        "status": {
          "enum": [
            "ok",
            "adc_error",
            "saturated"
          ]
        },
        "adc_raw": {
          "type": [
            "integer",
            "null"
          ]
        },
        "voltage_mv": {
          "type": [
            "integer",
            "null"
          ]
        },
        "adc_reference_mv": {
          "type": "integer",
          "minimum": 2500,
          "maximum": 3600
        },
        "reference_source": {
          "enum": [
            "nominal",
            "measured"
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "ok"
            },
            "adc_raw": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4094
            },
            "voltage_mv": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7200
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "adc_error"
            },
            "adc_raw": {
              "type": "null"
            },
            "voltage_mv": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "saturated"
            },
            "adc_raw": {
              "const": 4095
            },
            "voltage_mv": {
              "type": "null"
            }
          }
        }
      ],
      "$comment": "Runtime additionally validates exact integer ADC/reference/divider arithmetic."
    }
  ]
}
