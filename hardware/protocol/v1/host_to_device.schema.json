{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dutchmate.dev/protocol/v1/host_to_device.schema.json",
  "title": "DUTchMate v1 Host-to-Device Message",
  "oneOf": [
    {
      "title": "Configure GPIO Mode Command",
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd", "channel", "role", "mode", "active_level"],
      "properties": {
        "cmd": {
          "const": "configure_gpio_mode"
        },
        "channel": {
          "type": "string",
          "enum": ["CTRL0", "CTRL1", "CTRL2", "CTRL3"]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["open_drain", "push_pull"]
        },
        "active_level": {
          "type": "string",
          "enum": ["low", "high"]
        },
        "idle_level": {
          "type": "string",
          "enum": ["low", "high"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {"const": "open_drain"}
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "active_level": {"const": "low"}
            },
            "not": {
              "required": ["idle_level"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {"const": "push_pull"}
            },
            "required": ["mode"]
          },
          "then": {
            "required": ["idle_level"],
            "oneOf": [
              {
                "properties": {
                  "active_level": {"const": "low"},
                  "idle_level": {"const": "high"}
                }
              },
              {
                "properties": {
                  "active_level": {"const": "high"},
                  "idle_level": {"const": "low"}
                }
              }
            ]
          }
        }
      ]
    },
    {
      "title": "Reset Command",
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd", "pulse_ms"],
      "properties": {
        "cmd": {
          "const": "reset"
        },
        "pulse_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    {
      "title": "Set Boot Mode Command",
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd", "mode"],
      "properties": {
        "cmd": {
          "const": "set_boot_mode"
        },
        "mode": {
          "type": "string",
          "enum": ["normal", "bootloader"]
        }
      }
    },
    {
      "title": "UART Send Command",
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd", "data_b64"],
      "properties": {
        "cmd": {
          "const": "uart_send"
        },
        "data_b64": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    }
  ]
}
